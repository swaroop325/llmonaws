{
  "annotations": { "list": [] },
  "description": "vLLM Production Monitoring - AWS Multi-Instance",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Active Requests (per instance)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "vllm:num_requests_running", "legendFormat": "running - {{instance_id}}" },
        { "expr": "vllm:num_requests_waiting", "legendFormat": "waiting - {{instance_id}}" }
      ]
    },
    {
      "title": "Token Throughput (tok/s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "tokens/s" } },
      "targets": [
        { "expr": "sum(rate(vllm:generation_tokens_total[1m]))", "legendFormat": "generation (total)" },
        { "expr": "sum(rate(vllm:prompt_tokens_total[1m]))", "legendFormat": "prompt (total)" },
        { "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "gen - {{instance_id}}" }
      ]
    },
    {
      "title": "GPU KV Cache Usage",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "vllm:gpu_cache_usage_perc", "legendFormat": "{{instance_id}}" }
      ]
    },
    {
      "title": "E2E Request Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum by(le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Time to First Token (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Time Per Output Token (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le) (rate(vllm:time_per_output_token_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(vllm:time_per_output_token_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(vllm:time_per_output_token_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Queue Time (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le) (rate(vllm:request_queue_time_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(vllm:request_queue_time_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(vllm:request_queue_time_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Prefix Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "rate(vllm:gpu_prefix_cache_hits[5m]) / (rate(vllm:gpu_prefix_cache_queries[5m]) > 0)", "legendFormat": "hit rate - {{instance_id}}" }
      ]
    },
    {
      "title": "Request Finish Reasons",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "sum by(finished_reason) (rate(vllm:request_success_total[5m]))", "legendFormat": "{{finished_reason}}" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["vllm", "inference", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "vLLM Production",
  "uid": "vllm-prod-aws"
}
